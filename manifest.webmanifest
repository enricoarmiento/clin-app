{
  "name": "Clin - Clinical Data Anonymizer for AI",
  "short_name": "Clin",
  "description": "Anonimizzazione sul telefono di foto, PDF e testi sanitari prima dell'invio a un'IA.",
  "lang": "it",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "condividi",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "file", "accept": ["image/*", "application/pdf", ".pdf", "text/plain", "text/csv", ".docx"] }
      ]
    }
  }
}
